generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model WhatsAppLead {
  id        String   @id @default(cuid())
  requestId String   @unique
  source    String   @default("whatsapp")
  createdAt DateTime @default(now())

  @@index([requestId])
}

model FormLead {
  id          String   @id @default(cuid())
  requestId   String?
  name        String
  phone       String
  email       String?
  serviceType String
  city        String?
  message     String?
  source      String   @default("form")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([phone])
  @@index([requestId])
}

model Admin {
  id       String @id @default(cuid())
  username String @unique
  password String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
