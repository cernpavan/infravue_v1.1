# Wrangler Assets reads this file and applies the headers to matching
# requests served from public/. Long-lived immutable caching for our
# fingerprint-stable image directories. If a file ever needs to change,
# either rename it (e.g. hero_image_1.webp -> hero_image_1.v2.webp) or
# bust the cache via the Cloudflare dashboard.
#
# Docs: https://developers.cloudflare.com/workers/static-assets/headers/

/images/*
  Cache-Control: public, max-age=31536000, immutable

/favicon.ico
  Cache-Control: public, max-age=86400

/logo.jpg
  Cache-Control: public, max-age=31536000, immutable
/logo.svg
  Cache-Control: public, max-age=31536000, immutable
/logo_light.png
  Cache-Control: public, max-age=31536000, immutable
