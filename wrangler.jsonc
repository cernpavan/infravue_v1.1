{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "infravue",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Custom domain — declared here so `wrangler deploy` doesn't strip it.
  // The matching DNS record / zone must already exist in Cloudflare.
  "routes": [
    {
      "pattern": "infravueinteriors.com",
      "zone_name": "infravueinteriors.com",
      "custom_domain": true
    }
  ]
  // DATABASE_URL is set as a Worker SECRET (not a Plaintext var) —
  // secrets persist across deploys; Plaintext vars get overwritten.
  //   npx wrangler secret put DATABASE_URL
}
